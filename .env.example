# ═══════════════════════════════════════════════════════════════════════════════
# ClipBuilder — environment variables
#
#   cp .env.example .env && chmod 600 .env
#
# Never commit the real .env (already covered by .gitignore).
# Generate secrets with:  openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Required ─────────────────────────────────────────────────────────────────
# Postgres password (used by the `db` container and by the backend DATABASE_URL).
DB_PASSWORD=

# Signing secret for the application JWTs. openssl rand -hex 32
SECRET_KEY=

# Admin account seeded on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Database connection. Docker Compose injects this automatically;
# set it only when running the backend outside Compose.
# DATABASE_URL=postgresql://clipbuilder:PASSWORD@localhost:5432/clipbuilder

# ─── Clerk authentication ─────────────────────────────────────────────────────
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Optional: only when the host cannot resolve the custom Clerk domain.
# CLERK_JWKS_URI=https://api.clerk.com/v1/jwks
CLERK_AZP_STRICT=false
CLERK_AUTO_PROVISION_USERS=false

# HS256 token for the emergency local login (/sys/token). Empty = disabled.
LOCAL_JWT_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list. In production, use only the real domain.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
CLIPBUILDER_GEMINI_MODEL=models/gemini-2.5-flash
CLIPBUILDER_AI_LANGUAGE=pt-BR
# CLIPBUILDER_AGENT_MODEL=
# OPENAI_API_KEY=

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# ─── Public URLs ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ─── Payments (Mercado Pago) ──────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Video ingestion (yt-dlp) ─────────────────────────────────────────────────
# 6 GiB by default.
CLIPBUILDER_MAX_VIDEO_BYTES=6442450944
CLIPBUILDER_YTDLP_COOKIES_FILE=/app/data/cookies.txt
# A residential proxy is the best remedy against datacenter IP blocks.
# CLIPBUILDER_YTDLP_PROXY=http://user:pass@host:port
# CLIPBUILDER_YTDLP_PO_TOKEN_EXTRACTOR_URL=
# CLIPBUILDER_YTDLP_COOKIES_FROM_BROWSER=

# ─── Frontend build (injected by Compose at build time) ───────────────────────
VITE_CLERK_PUBLISHABLE_KEY=
VITE_MP_PUBLIC_KEY=
VITE_TURNSTILE_SITE_KEY=
